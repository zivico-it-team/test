PORT=5000
NODE_ENV=production
TRUST_PROXY=true

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password

JWT_SECRET=replace_with_a_long_random_secret

DB_SYNC=false

CLIENT_URL=https://crm.revoraglobal.com
ALLOWED_ORIGINS=https://crm.revoraglobal.com,https://revoraglobal.com
API_BASE_URL=https://revoraglobal.com
RESET_TOKEN_EXPIRES_MINUTES=15

MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=no-reply@revoraglobal.com
MAIL_PASS=replace_with_mail_password
MAIL_FROM=Revoraglobal CRM <no-reply@revoraglobal.com>
MAIL_SECURE=true

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_admin_password

HR_NAME=HR Manager
HR_EMAIL=hr@example.com
HR_USERNAME=hr
HR_PASSWORD=change_hr_password
HR_DESIGNATION=HR Manager
